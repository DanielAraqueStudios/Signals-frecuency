THEORY/FIRST_ROUND/TEST2/PUNTO_3/output/

# User-provided real photo (bank card) used as PUNTO_3 input -- personal
# image, not checked in; PUNTO_3 falls back to a synthetic generated image
# when this file is absent (see PUNTO_3/readme.md)
THEORY/FIRST_ROUND/TEST2/muestras/imagen.jpg

# User-provided audio samples (large binaries, not checked in)
THEORY/FIRST_ROUND/WORK/WORK_THREE/audio_samples/*/*.wav
THEORY/FIRST_ROUND/WORK/WORK_THREE/audio_samples/*/*.mp3
THEORY/FIRST_ROUND/WORK/WORK_THREE/audio_samples/*/*.flac
THEORY/FIRST_ROUND/WORK/WORK_THREE/audio_samples/*/*.ogg
THEORY/FIRST_ROUND/WORK/WORK_THREE/audio_samples/*/*.m4a

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# PARTS_SORTING_PLATFORM (CLOUD_MODE): dev-only TLS certs/keys and
# Mosquitto password file generated by scripts/gen-dev-certs.sh -- never
# real secrets, but never committed either (see
# CLOUD_MODE/mqtt-broker/certs/README.md)
PARTS_SORTING_PLATFORM/CLOUD_MODE/mqtt-broker/certs/*.crt
PARTS_SORTING_PLATFORM/CLOUD_MODE/mqtt-broker/certs/*.key
PARTS_SORTING_PLATFORM/CLOUD_MODE/mqtt-broker/certs/*.csr
PARTS_SORTING_PLATFORM/CLOUD_MODE/mqtt-broker/certs/*.srl
PARTS_SORTING_PLATFORM/CLOUD_MODE/mqtt-broker/config/passwd

# PARTS_SORTING_PLATFORM (CLOUD_MODE): dev-only RSA keypair for JWT
# signing/verification, generated by scripts/gen-dev-jwt-keys.sh -- never
# committed
PARTS_SORTING_PLATFORM/CLOUD_MODE/.dev-secrets/

# Python venvs anywhere in the new platform folder
PARTS_SORTING_PLATFORM/**/.venv/

# mobile-app (Expo/React Native)
PARTS_SORTING_PLATFORM/mobile-app/node_modules/
PARTS_SORTING_PLATFORM/mobile-app/.expo/
