# Generated convolution figures (regenerated by main.py)
THEORY/FIRST_ROUND/WORK/WORK_FOUR/output/

# Generated AM/aliasing analysis figure (regenerated by main.py)
THEORY/FIRST_ROUND/WORK/WORK_FIVE/output/

# Generated wavelet/correlation-vector figures (regenerated by main.py)
THEORY/FIRST_ROUND/WORK/WORK_SIX/output/

# Generated FIR/IIR/Hilbert filtering figures (regenerated by main.py)
THEORY/FIRST_ROUND/WORK/WORK_TEN/output/

# Generated moving-average filter figures (regenerated by main.py)
THEORY/FIRST_ROUND/WORK/WORK_SEVEN/output/

# Generated filter-design figures (regenerated by main.py)
THEORY/FIRST_ROUND/WORK/WORK_EIGHT/output/

# Generated AM modulation figures (regenerated by main.py)
THEORY/FIRST_ROUND/WORK/WORK_NINE/output/

