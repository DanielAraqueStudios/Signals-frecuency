# Ruflo / claude-flow
.claude/
.claude-flow/
.swarm/
ruvector.db

# Claude Code project instructions
CLAUDE.md
.mcp.json

# Node
node_modules/
package-lock.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# Generated audio output
THEORY/FIRST_ROUND/WORK/WORK_ONE/output/

# Generated convolution figures (regenerated by main.py)
THEORY/FIRST_ROUND/WORK/WORK_FOUR/output/

# User-provided audio samples (large binaries, not checked in)
THEORY/FIRST_ROUND/WORK/WORK_THREE/audio_samples/*/*.wav
THEORY/FIRST_ROUND/WORK/WORK_THREE/audio_samples/*/*.mp3
THEORY/FIRST_ROUND/WORK/WORK_THREE/audio_samples/*/*.flac
THEORY/FIRST_ROUND/WORK/WORK_THREE/audio_samples/*/*.ogg
THEORY/FIRST_ROUND/WORK/WORK_THREE/audio_samples/*/*.m4a

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# PARTS_SORTING_PLATFORM: dev-only TLS certs/keys and Mosquitto password
# file generated by scripts/gen-dev-certs.sh -- never real secrets, but
# never committed either (see mqtt-broker/certs/README.md)
PARTS_SORTING_PLATFORM/mqtt-broker/certs/*.crt
PARTS_SORTING_PLATFORM/mqtt-broker/certs/*.key
PARTS_SORTING_PLATFORM/mqtt-broker/certs/*.csr
PARTS_SORTING_PLATFORM/mqtt-broker/certs/*.srl
PARTS_SORTING_PLATFORM/mqtt-broker/config/passwd

# PARTS_SORTING_PLATFORM: dev-only RSA keypair for JWT signing/verification,
# generated by scripts/gen-dev-jwt-keys.sh -- never committed
PARTS_SORTING_PLATFORM/.dev-secrets/

# PARTS_SORTING_PLATFORM: trained classifier weights are supplied by the
# user, not committed (no dataset exists yet -- see
# services/classification-service/model/README.md)
PARTS_SORTING_PLATFORM/services/classification-service/model/weights/*.onnx
PARTS_SORTING_PLATFORM/services/classification-service/model/data/

# Python venvs anywhere in the new platform folder
PARTS_SORTING_PLATFORM/**/.venv/

# mobile-app (Expo/React Native)
PARTS_SORTING_PLATFORM/mobile-app/node_modules/
PARTS_SORTING_PLATFORM/mobile-app/.expo/
